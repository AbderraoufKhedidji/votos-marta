# Credenciales de admin (login web)
ADMIN_USER=admin
ADMIN_PASSWORD=password

# Base de datos Turso (libSQL/SQLite). Se autorellena al vincular Turso en Vercel.
# En local no hace falta: si no se define, se usa SQLite en disco (data/votos.db).
# TURSO_DATABASE_URL=libsql://<tu-db>.turso.io
# TURSO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vercel Blob (para subir fotos). Se autorellena al vincular Blob en Vercel.
# En local no hace falta: si no se define, las fotos se guardan en public/uploads/.
# BLOB_READ_WRITE_TOKEN=...

# Hook de Twitch (bot que graba votos en segundo plano; opcional, no se ejecuta en Vercel)
TWITCH_CHANNEL=darkmius
TWITCH_USERNAME=votosmarta_bot
TWITCH_OAUTH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxx
# El hook usa TURSO_DATABASE_URL/TURSO_AUTH_TOKEN (las mismas que la web) para escribir votos.
