# Credenciales de admin (login web)
ADMIN_USER=admin
ADMIN_PASSWORD=password

# Canal de Twitch que se escucha en la vista de votación en directo (/votar/[id]).
# La conexión al IRC es anónima desde el navegador: no necesita token.
TWITCH_CHANNEL=darkmius

# --- Opcional: hook de Twitch legacy (bot que graba votos en segundo plano) ---
# NO hace falta para la web. Solo si ejecutas `npm run twitch-hook`.
# TWITCH_USERNAME=votosmarta_bot
# TWITCH_OAUTH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxx
#
# El hook legacy usa la antigua capa src/lib/db.mjs (SQLite local / Turso).
# Si lo usas con Turso, descomenta estas dos variables:
# TURSO_DATABASE_URL=libsql://<tu-db>.turso.io
# TURSO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NOTA: La web NO necesita base de datos ni Vercel Blob. Toda la persistencia
# se hace en el localStorage del navegador (src/lib/storage.js).
