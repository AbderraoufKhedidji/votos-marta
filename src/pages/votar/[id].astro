---
import Base from '../../layouts/Base.astro';
import { VotacionDirecto } from '../../components/votacion/VotacionDirecto.jsx';

export const prerender = false;

const id = Number(Astro.params.id);
const channel = process.env.TWITCH_CHANNEL || 'darkmius';
const authed = Astro.locals.authed === true;
---
<Base title="Votando · Votos Marta">
  <a href="/resultados" class="text-sm text-[var(--muted)] hover:text-[var(--accent)]">← Volver a resultados</a>
  <div class="mt-3">
    <VotacionDirecto actorId={id} channel={channel} authed={authed} client:load />
  </div>
</Base>
