---
import Base from '../../../../layouts/Base.astro';
import { getCategory } from '../../../../lib/db.mjs';

export const prerender = false;

const id = Number(Astro.params.id);
const category = await getCategory(id);
if (!category) {
  return Astro.redirect('/admin');
}
---
<Base title={`Editar · ${category.name}`} authed>
  <a href={`/admin/categorias/${id}`} class="text-sm text-[var(--muted)] hover:text-[var(--accent)]">← Volver</a>
  <h1 class="text-2xl font-bold mt-2 mb-6">Editar categoría</h1>
  <form action={`/api/categorias/${id}?_method=PUT`} method="POST" class="card p-6 space-y-4 max-w-lg">
    <div>
      <label class="label" for="name">Nombre</label>
      <input class="input" id="name" name="name" type="text" required value={category.name} />
    </div>
    <div>
      <label class="label" for="description">Descripción</label>
      <textarea class="textarea" id="description" name="description" rows="3">{category.description ?? ''}</textarea>
    </div>
    <div class="flex gap-2 justify-end">
      <a href={`/admin/categorias/${id}`} class="btn">Cancelar</a>
      <button class="btn btn-primary" type="submit">Guardar</button>
    </div>
  </form>
</Base>
