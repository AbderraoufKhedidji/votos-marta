---
import Base from '../../../../layouts/Base.astro';

export const prerender = false;

const id = Astro.params.id;
---
<Base title="Categoría · Votos Marta" authed>
  <a href="/admin" class="text-sm text-[var(--muted)] hover:text-[var(--accent)]">← Volver</a>
  <div id="root" class="mt-2"></div>
</Base>

<script>
  import { getCategory, listActors, getActiveActorId, setActiveActor, clearActiveActor, deleteActor, deleteCategory } from '../../../../lib/storage.js';

  const id = location.pathname.split('/').filter(Boolean)[2];

  function escapeHtml(s) {
    return String(s ?? '').replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[c]));
  }

  function render() {
    const el = document.getElementById('root');
    const category = getCategory(id);
    if (!category) { location.href = '/admin'; return; }
    const actors = listActors(id);
    const activeId = getActiveActorId();

    const activeBlock = activeId ? `
      <div class="card p-4 mb-5 flex items-center gap-3" style="border-color: var(--accent);">
        <span class="inline-block w-2 h-2 rounded-full bg-[var(--accent)] animate-pulse"></span>
        <div class="flex-1">
          <p class="text-sm text-[var(--muted)]">Votación activa ahora mismo:</p>
          <p class="font-bold">Los votos del chat de Twitch irán a este actor <span class="text-[var(--muted)] font-normal">(actívalo desde la ficha de cada actor)</span></p>
        </div>
        <button class="btn" data-deactivate>Detener votación</button>
      </div>` : '';

    const grid = actors.length === 0
      ? `<div class="card p-10 text-center"><p class="text-[var(--muted)]">Aún no hay actores en esta categoría.</p>
          <a href="/admin/categorias/${id}/nuevo-actor" class="btn btn-primary mt-4 inline-flex">Añadir el primero</a></div>`
      : `<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">` + actors.map((a) => `
        <div class="card p-4 flex gap-4">
          <div class="w-20 h-24 rounded-lg overflow-hidden flex-shrink-0 bg-[var(--panel-2)]">
            ${a.photo_url
              ? `<img src="${escapeHtml(a.photo_url)}" alt="${escapeHtml(a.name)}" class="w-full h-full object-cover" />`
              : `<div class="w-full h-full flex items-center justify-center text-[var(--muted)] text-xs">Sin foto</div>`}
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="font-bold leading-tight truncate">${escapeHtml(a.name)}</h3>
            ${a.role ? `<p class="text-[var(--muted)] text-sm truncate">${escapeHtml(a.role)}</p>` : ''}
            <div class="flex gap-2 mt-2 flex-wrap">
              <span class="badge">${a.vote_count} votos</span>
              ${a.vote_count > 0 ? `<span class="badge">media ${Number(a.avg_score).toFixed(1)}</span>` : ''}
            </div>
            <div class="flex gap-2 mt-3 flex-wrap">
              <a href="/votar/${a.id}" target="_blank" class="btn text-xs py-1 px-2">Ver en directo ↗</a>
              <a href="/admin/categorias/${id}/actores/${a.id}/editar" class="btn text-xs py-1 px-2">Editar</a>
              <button class="btn text-xs py-1 px-2 ${activeId === a.id ? 'btn-primary' : ''}" data-activate="${a.id}">
                ${activeId === a.id ? 'Votando ✓' : 'Activar votación'}
              </button>
              <button class="btn btn-danger text-xs py-1 px-2" data-del-actor="${a.id}">Borrar</button>
            </div>
          </div>
        </div>
      `).join('') + `</div>`;

    el.innerHTML = `
      <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
        <div>
          <h1 class="text-2xl font-bold">${escapeHtml(category.name)}</h1>
          ${category.description ? `<p class="text-[var(--muted)] text-sm mt-1">${escapeHtml(category.description)}</p>` : ''}
        </div>
        <div class="flex gap-2">
          <a href="/admin/categorias/${id}/editar" class="btn">Editar categoría</a>
          <a href="/admin/categorias/${id}/nuevo-actor" class="btn btn-primary">+ Nuevo actor</a>
        </div>
      </div>
      ${activeBlock}
      <h2 class="font-bold text-lg mb-3">Actores / actrices</h2>
      ${grid}
      <div class="mt-10 border-t border-[var(--border)] pt-6">
        <details>
          <summary class="cursor-pointer text-sm text-[var(--muted)] hover:text-[var(--accent)]">Zona de peligro</summary>
          <button class="btn btn-danger mt-3" data-del-cat>Eliminar categoría</button>
        </details>
      </div>
    `;

    if (activeId) {
      el.querySelector('[data-deactivate]')?.addEventListener('click', () => {
        clearActiveActor();
        render();
      });
    }
    el.querySelectorAll('[data-activate]').forEach((b) => {
      b.addEventListener('click', () => {
        setActiveActor(b.getAttribute('data-activate'));
        render();
      });
    });
    el.querySelectorAll('[data-del-actor]').forEach((b) => {
      b.addEventListener('click', () => {
        if (confirm('¿Eliminar este actor?')) {
          deleteActor(b.getAttribute('data-del-actor'));
          render();
        }
      });
    });
    el.querySelector('[data-del-cat]')?.addEventListener('click', () => {
      if (confirm('¿Eliminar esta categoría y todos sus actores?')) {
        deleteCategory(id);
        location.href = '/admin';
      }
    });
  }

  render();
</script>
