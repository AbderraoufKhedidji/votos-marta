---
import Base from '../../layouts/Base.astro';

export const prerender = false;
---
<Base title="Panel · Votos Marta" authed>
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold">Categorías</h1>
      <p class="text-[var(--muted)] text-sm">Cada categoría agrupa actores o actrices.</p>
    </div>
    <a href="/admin/categorias/nueva" class="btn btn-primary">+ Nueva categoría</a>
  </div>

  <div id="cats"></div>
</Base>

<script>
  import { listCategories, deleteCategory } from '../../lib/storage.js';

  function escapeHtml(s) {
    return String(s ?? '').replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[c]));
  }

  function render() {
    const el = document.getElementById('cats');
    const cats = listCategories();
    if (cats.length === 0) {
      el.innerHTML = `
        <div class="card p-10 text-center">
          <p class="text-[var(--muted)]">Aún no hay categorías.</p>
          <a href="/admin/categorias/nueva" class="btn btn-primary mt-4 inline-flex">Crear la primera</a>
        </div>`;
      return;
    }
    el.innerHTML = `<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">` + cats.map((c) => `
      <div class="card p-5 flex flex-col" data-id="${c.id}">
        <a href="/admin/categorias/${c.id}" class="flex items-start justify-between gap-2 hover:text-[var(--accent)] transition">
          <h3 class="font-bold text-lg leading-tight">${escapeHtml(c.name)}</h3>
          <span class="badge">${c.actor_count} actores</span>
        </a>
        ${c.description ? `<p class="text-[var(--muted)] text-sm mt-2 line-clamp-2">${escapeHtml(c.description)}</p>` : ''}
        <div class="flex gap-2 mt-4 pt-3 border-t border-[var(--border)]">
          <a href="/admin/categorias/${c.id}" class="btn text-xs py-1 px-2 flex-1 text-center">Abrir</a>
          <button class="btn btn-danger text-xs py-1 px-2" data-del="${c.id}" data-name="${escapeHtml(c.name)}">Borrar</button>
        </div>
      </div>
    `).join('') + `</div>`;

    el.querySelectorAll('[data-del]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-del');
        const name = btn.getAttribute('data-name');
        if (confirm(`¿Eliminar la categoría «${name}» y todos sus actores y votos?`)) {
          deleteCategory(id);
          render();
        }
      });
    });
  }

  render();
</script>
