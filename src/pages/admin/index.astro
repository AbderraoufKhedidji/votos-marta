---
import Base from '../../layouts/Base.astro';
import { listCategories } from '../../lib/db.mjs';

export const prerender = false;

const categories = await listCategories().catch(() => []);
---
<Base title="Panel · Votos Marta" authed>
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold">Categorías</h1>
      <p class="text-[var(--muted)] text-sm">Cada categoría agrupa actores o actrices.</p>
    </div>
    <a href="/admin/categorias/nueva" class="btn btn-primary">+ Nueva categoría</a>
  </div>

  {categories.length === 0 ? (
    <div class="card p-10 text-center">
      <p class="text-[var(--muted)]">Aún no hay categorías.</p>
      <a href="/admin/categorias/nueva" class="btn btn-primary mt-4 inline-flex">Crear la primera</a>
    </div>
  ) : (
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {categories.map((c) => (
        <div class="card p-5 flex flex-col">
          <a href={`/admin/categorias/${c.id}`} class="flex items-start justify-between gap-2 hover:text-[var(--accent)] transition">
            <h3 class="font-bold text-lg leading-tight">{c.name}</h3>
            <span class="badge">{c.actor_count} actores</span>
          </a>
          {c.description && <p class="text-[var(--muted)] text-sm mt-2 line-clamp-2">{c.description}</p>}
          <div class="flex gap-2 mt-4 pt-3 border-t border-[var(--border)]">
            <a href={`/admin/categorias/${c.id}`} class="btn text-xs py-1 px-2 flex-1 text-center">Abrir</a>
            <form action={`/api/categorias/${c.id}?_method=DELETE`} method="POST"
                  onsubmit="return confirm('¿Eliminar la categoría «{c.name}» y todos sus actores y votos?')">
              <button class="btn btn-danger text-xs py-1 px-2" type="submit">Borrar</button>
            </form>
          </div>
        </div>
      ))}
    </div>
  )}
</Base>
