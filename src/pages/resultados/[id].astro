---
import Base from '../../layouts/Base.astro';

export const prerender = false;

const id = Astro.params.id;
---
<Base title="Resultados · Votos Marta">
  <a href="/resultados" class="text-sm text-[var(--muted)] hover:text-[var(--accent)]">← Volver</a>
  <div id="root"></div>
</Base>

<script>
  import { getCategory, listActors } from '../../lib/storage.js';
  import { imgTag } from '../../lib/image.js';

  const id = new URLSearchParams(location.search).get('id') || location.pathname.split('/').pop();
  let query = '';

  function escapeHtml(s) {
    return String(s ?? '').replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[c]));
  }

  function normalize(s) {
    return String(s || '')
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '');
  }

  function renderCards(actors) {
    if (actors.length === 0) {
      return `<p class="text-[var(--muted)] mt-4">${query ? 'No hay coincidencias.' : 'Sin actores todavía.'}</p>`;
    }
    return `<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 mt-4">` + actors.map((a, i) => `
      <div class="card p-4 flex gap-4">
        <div class="w-20 h-24 rounded-lg overflow-hidden flex-shrink-0 bg-[var(--panel-2)]">
          ${imgTag(a.photo_url, a.name, { className: 'w-full h-full object-cover object-top' })}
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2">
            ${i === 0 && a.vote_count > 0 && !query ? `<span class="badge" style="color: #fbbf24; border-color:#fbbf24;">#1</span>` : ''}
            <h3 class="font-bold leading-tight truncate">${escapeHtml(a.name)}</h3>
          </div>
          ${a.role ? `<p class="text-[var(--muted)] text-sm truncate">${escapeHtml(a.role)}</p>` : ''}
          <div class="flex gap-2 mt-2 flex-wrap">
            <span class="badge">${a.vote_count} votos</span>
            ${a.vote_count > 0 ? `<span class="badge" style="color: var(--accent);">⭐ ${Number(a.avg_score).toFixed(1)}</span>` : ''}
          </div>
          <a href="/votar/${a.id}" class="btn btn-primary text-xs py-1 px-2 mt-3 inline-flex">Ver votación en directo</a>
        </div>
      </div>
    `).join('') + `</div>`;
  }

  function render() {
    const el = document.getElementById('root');
    const category = getCategory(id);
    if (!category) {
      location.href = '/resultados';
      return;
    }
    let actors = listActors(id);
    actors = [...actors].sort((a, b) => (b.avg_score || 0) - (a.avg_score || 0) || (b.vote_count || 0) - (a.vote_count || 0));

    const q = normalize(query);
    const filtered = q
      ? actors.filter((a) => normalize(a.name).includes(q) || normalize(a.role).includes(q))
      : actors;

    el.innerHTML = `
      <h1 class="text-2xl font-bold mt-2">${escapeHtml(category.name)}</h1>
      ${category.description ? `<p class="text-[var(--muted)] text-sm mt-1">${escapeHtml(category.description)}</p>` : ''}
      <div class="mt-4 max-w-md">
        <label class="label" for="search">Buscar</label>
        <input class="input" id="search" type="search" placeholder="Nombre o rol…" value="${escapeHtml(query)}" autocomplete="off" />
      </div>
      <div id="list">${renderCards(filtered)}</div>
    `;

    const input = document.getElementById('search');
    input?.focus();
    // colocar cursor al final
    if (input && query) {
      const len = input.value.length;
      input.setSelectionRange(len, len);
    }
    input?.addEventListener('input', (e) => {
      query = e.target.value;
      const q2 = normalize(query);
      const next = q2
        ? actors.filter((a) => normalize(a.name).includes(q2) || normalize(a.role).includes(q2))
        : actors;
      document.getElementById('list').innerHTML = renderCards(next);
    });
  }

  render();
</script>
