---
import Base from '../../layouts/Base.astro';

export const prerender = false;
---
<Base title="Resultados · Votos Marta">
  <h1 class="text-2xl font-bold mb-1">Resultados</h1>
  <p class="text-[var(--muted)] text-sm mb-6">Puntuaciones de cada categoría.</p>

  <div id="cats" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    <p class="text-[var(--muted)]">Cargando…</p>
  </div>
</Base>

<script>
  import { listCategoriesWithVotes } from '../../lib/storage.js';
  import { imgTag } from '../../lib/image.js';

  function escapeHtml(s) {
    return String(s ?? '').replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[c]));
  }

  function render() {
    const el = document.getElementById('cats');
    const cats = listCategoriesWithVotes();
    if (cats.length === 0) {
      el.innerHTML = '<p class="text-[var(--muted)]">Todavía no hay categorías.</p>';
      return;
    }
    el.innerHTML = cats.map((c) => `
      <a href="/resultados/${c.id}" class="card overflow-hidden hover:border-[var(--accent)] transition flex gap-0">
        <div class="w-24 sm:w-28 flex-shrink-0 min-h-[8.5rem] self-stretch bg-[var(--panel-2)] overflow-hidden">
          ${imgTag(c.cover_url, c.cover_name || c.name, { className: 'w-full h-full object-cover object-top' })}
        </div>
        <div class="p-4 flex flex-col justify-center min-w-0 flex-1">
          <h3 class="font-bold text-lg leading-tight">${escapeHtml(c.name)}</h3>
          ${c.description ? `<p class="text-[var(--muted)] text-sm mt-1 line-clamp-2">${escapeHtml(c.description)}</p>` : ''}
          <div class="flex gap-2 mt-3 flex-wrap">
            <span class="badge">${c.actor_count} actores</span>
            <span class="badge">${c.vote_count} votos</span>
          </div>
        </div>
      </a>
    `).join('');
  }

  render();
</script>
